        @Repository
        public interface StudentRepository extends JpaRepository<Student, Integer> {

            @Query("Select s From Student s where s.studentId=:id")   // with name like ':id' @Param() is needed
            public Student getStudentById(@Param("id") int id);

            @Query("select s From Student s where s.marks=?1")   // with '?' there is no need to use @Param()
            public List<Student> getStudentByMarks(int marks);

            // we can also write 'Native Query' by, (native query means normal sql)
            // @Query(value = "select * from students where marks=?1", nativeQuery = true)

            // also the @Query is not necessary, as JPA comes with own 'finder' methods
            //      i.e. if the method name is findByName(), it understands and JPA on its own writes the query.
            //      some examples, findByNameStartingWith() , findByNameAndMarks() , ...
        }

